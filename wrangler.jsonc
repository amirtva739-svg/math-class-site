{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "math-class-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "math-class-db",
      "database_id": "2d24b3a1-24f3-41eb-9005-63fe9bca04d1"
    }
  ]
}
